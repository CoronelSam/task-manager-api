{
  "info": {
    "name": "Task Manager API",
    "description": "API REST segura con autenticación JWT (Node.js + Express + Sequelize + MySQL).\n\n**Uso:** ejecuta las carpetas en orden (o el Collection Runner). `Login` guarda automáticamente el token en la variable `{{token}}` y todas las peticiones de tareas lo envían como `Authorization: Bearer {{token}}`.\n\nCada petición incluye tests automáticos. También puede ejecutarse por consola con `pnpm test:postman` (Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "userName",
      "value": "Ana Pérez"
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": "Password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "userBEmail",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "privateTaskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('API operativa', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email único en cada ejecución para poder correr la colección varias veces",
                  "pm.collectionVariables.set('userEmail', `ana_${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const { user } = pm.response.json();",
                  "pm.test('Devuelve el usuario creado', () => {",
                  "    pm.expect(user).to.have.property('id');",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "});",
                  "pm.test('No expone el password', () => pm.expect(user).to.not.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registra un usuario. El email debe ser único y la contraseña se guarda encriptada con bcrypt."
          },
          "response": []
        },
